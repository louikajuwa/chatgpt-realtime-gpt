# Copy to .env and edit. Never commit .env.

# --- OpenAI ---
# Required for live responses (key needs Realtime API access).
OPENAI_API_KEY=sk-your-key-here
# Realtime model, voice and input-transcription model.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Realtime WebSocket endpoint. Override only for mock testing (e.g. ws://host.docker.internal:8089).
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# --- Redis ---
# Compose service name.
REDIS_HOST=redis
REDIS_PORT=6379
# Optional. If set, compose starts Redis with --requirepass and the app authenticates.
REDIS_PASSWORD=

# --- App ---
# In-container listen port (compose maps it to 127.0.0.1:3004).
PORT=3000
# Optional. When set, the browser must enter this token. SET THIS before exposing the app beyond localhost.
APP_ACCESS_TOKEN=
# Comma-separated allowed browser origins (e.g. https://voice.example.com). Empty = same-origin only.
ALLOWED_ORIGINS=
# Maximum concurrent Socket.IO connections.
MAX_CONNECTIONS=20
# Maximum length (characters) of the stored brain.
BRAIN_MAX_CHARS=20000
